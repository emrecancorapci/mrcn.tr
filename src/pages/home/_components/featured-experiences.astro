---
import { Button } from "@/components/ui/button";
import H1 from "@/components/ui/h1.astro";
---

<div class="bg-primary flex w-full flex-col items-center py-20">
  <div class="grid w-full max-w-7xl gap-20 px-30">
    <H1 class="text-primary-foreground w-full">featured experiences</H1>
    <div class="grid">
      <div class="flex items-baseline justify-between border-b px-4 py-5">
        <div class="flex items-baseline gap-4">
          <h2 class="text-primary-foreground text-4xl font-semibold">Nohut Akademi</h2>
          <p class="text-primary-foreground/70 -translate-y-1">Back-End Developer</p>
        </div>
        <p class="text-primary-foreground/80">2025</p>
      </div>
      <div class="flex items-baseline justify-between border-b px-4 py-5">
        <div class="flex items-baseline gap-4">
          <h2 class="text-primary-foreground text-4xl font-semibold">Tetra</h2>
          <p class="text-primary-foreground/70 -translate-y-1">Full-Stack Web Developer</p>
        </div>
        <p class="text-primary-foreground/80">2024</p>
      </div>
      <div class="flex items-baseline justify-between px-4 py-5">
        <div class="flex items-baseline gap-4">
          <h2 class="text-primary-foreground text-4xl font-semibold">Turkcell</h2>
          <p class="text-primary-foreground/70 -translate-y-1">Full-Stack Web Developer</p>
        </div>
        <p class="text-primary-foreground/80">2022</p>
      </div>
    </div>
    <div class="flex justify-end">
      <Button size="xl" variant="secondary">View More</Button>
    </div>
  </div>
</div>
