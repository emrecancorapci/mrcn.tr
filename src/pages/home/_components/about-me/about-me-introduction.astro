---
import { Picture } from "astro:assets";

import imgMe from "@/images/me-with-bg.png";
import H2 from "@/components/ui/h2.astro";
import { currentLocale, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);
---

<div class="grid grid-cols-1 gap-16 lg:grid-cols-2">
  <div class="flex flex-col gap-1 pt-0 lg:pt-10">
    <Picture
      formats={["webp", "png"]}
      src={imgMe}
      class="border-foreground shadow-foreground/5 h-80 rounded-xl border-2 object-cover shadow-lg"
      alt={t(locale, "about.alt.illustration")}
    />
    <p class="text-foreground/30 px-2 text-end">{t(locale, "about.illustrationCredit")}</p>
  </div>
  <div class="space-y-6 py-4">
    <H2 class="text-shadow-foreground/5 text-shadow-lg">
      {t(locale, "about.introductionHeading")}
    </H2>
    <div class="space-y-4">
      <p class="text-pretty">{t(locale, "about.p1")}</p>
      <p class="text-pretty">{t(locale, "about.p2")}</p>
      <p class="text-pretty">{t(locale, "about.p3")}</p>
    </div>
  </div>
</div>
