---
import H2 from "@/components/ui/h2.astro";
import Section from "@/components/ui/section.astro";
import { currentLocale, t } from "@/i18n";

import AboutMeInterests from "./about-me-interests.astro";
import AboutMeIntroduction from "./about-me-introduction.astro";
import AboutMeImages from "./about-me-images.astro";

const locale = currentLocale(Astro.currentLocale);
---

<div class="flex w-full flex-col items-center">
  <Section class="grid gap-20 py-20">
    <H2 class="scroll-reveal text-shadow-foreground/5 w-full text-shadow-lg">
      {t(locale, "about.heading")}
    </H2>
    <div class="space-y-20">
      <AboutMeIntroduction />
      <AboutMeInterests />
    </div>
  </Section>
  <AboutMeImages />
</div>
