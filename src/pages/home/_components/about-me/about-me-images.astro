---
import { Picture } from "astro:assets";

import imgAboutMeCat from "@/images/about-me-cat.jpeg";
import imgAboutMeCat2 from "@/images/about-me-cat-2.jpeg";
import imgAboutMeBicycle from "@/images/about-me-bicycle.jpeg";
import imgAboutMeConcert from "@/images/about-me-concert.jpeg";
import imgAboutMeMe from "@/images/about-me-me.jpeg";
import { currentLocale, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

const frameClass =
  "border-foreground min-h-[70dvw] lg:min-h-[30dvw] shadow-foreground/5 h-80 rounded-xl border-2 object-cover shadow-lg";
---

<div class="grid grid-cols-2 gap-4 px-4 pb-20 lg:grid-cols-5 lg:gap-10 lg:px-40">
  <Picture
    src={imgAboutMeCat}
    formats={["webp", "jpeg"]}
    class={frameClass}
    alt={t(locale, "about.alt.cat")}
  />
  <Picture
    src={imgAboutMeBicycle}
    formats={["webp", "jpeg"]}
    class={frameClass}
    alt={t(locale, "about.alt.bicycle")}
  />
  <Picture
    src={imgAboutMeConcert}
    formats={["webp", "jpeg"]}
    class={frameClass}
    alt={t(locale, "about.alt.concert")}
  />
  <Picture
    src={imgAboutMeCat2}
    formats={["webp", "jpeg"]}
    class={frameClass}
    alt={t(locale, "about.alt.cat2")}
  />
  <Picture
    src={imgAboutMeMe}
    formats={["webp", "jpeg"]}
    class={frameClass}
    alt={t(locale, "about.alt.me")}
  />
</div>
