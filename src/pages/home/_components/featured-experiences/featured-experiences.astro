---
import { getCollection } from "astro:content";

import { buttonVariants } from "@/components/ui/button";
import H2 from "@/components/ui/h2.astro";
import Section from "@/components/ui/section.astro";
import { currentLocale, localePath, t } from "@/i18n";
import { forLocale } from "@/lib/i18n-content";
import FeaturedExperiencesCard from "./featured-experiences-card.astro";

const locale = currentLocale(Astro.currentLocale);

const featuredExperiences = forLocale(await getCollection("experiences"), locale)
  .filter((experience) => experience.data.featured)
  .sort((a, b) => a.data.priority - b.data.priority);
---

<div class="bg-primary flex w-full flex-col items-center py-20">
  <Section class="grid gap-20">
    <H2 class="text-primary-foreground scroll-reveal w-full">
      {t(locale, "featured.experiencesHeading")}
    </H2>
    <div class="grid w-full gap-10">
      <div class="grid">
        {featuredExperiences.map(({ data }) => (
          <FeaturedExperiencesCard experience={data} />
        ))}
      </div>
      <div class="flex scroll-reveal justify-end">
        <a
          href={localePath(locale, "/experiences")}
          class={buttonVariants({ size: "xl", variant: "secondary" })}
        >
          {t(locale, "featured.viewMore")}
        </a>
      </div>
    </div>
  </Section>
</div>
