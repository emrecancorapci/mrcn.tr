---
import { companyAnchor } from "@/lib/content";
import { currentLocale, localePath } from "@/i18n";
import type { CollectionEntry } from "astro:content";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  experience: CollectionEntry<"experiences">["data"];
}

const {
  experience: { company, title, start },
} = Astro.props;

const startYear = (start: string) => start.match(/\d{4}/)?.[0] ?? start;
---

<a
  href={localePath(locale, `/experiences#${companyAnchor(company)}`)}
  class:list={[
    "bg-foreground/0 scroll-reveal hover:bg-chart-1 dark:hover:bg-foreground/20 border-primary-foreground/10 flex items-center justify-between px-0 py-5 transition-all duration-300 ease-out not-last:border-b hover:scale-x-102 hover:border-0 lg:px-4",
  ]}
>
  <div class="flex items-center gap-4">
    <h2 class="text-primary-foreground text-2xl leading-none font-semibold lg:text-4xl">
      {company}
    </h2>
    <p class="text-primary-foreground/70 leading-none lg:translate-y-0.5">{title}</p>
  </div>
  <p class="text-primary-foreground/80 leading-none">{startYear(start)}</p>
</a>
