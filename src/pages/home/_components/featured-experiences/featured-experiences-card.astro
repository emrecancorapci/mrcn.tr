---
interface Props {
  company: string;
  title: string;
  start: string;
  last?: boolean;
}

const { company, title, start, last } = Astro.props;
---

<div class:list={["flex items-baseline justify-between px-4 py-5", !last && "border-b"]}>
  <a
    href=`/experiences#${company.toLocaleLowerCase().replaceAll(" ", "-")}`
    class="flex items-baseline gap-4"
  >
    <h2 class="text-primary-foreground text-4xl font-semibold">{company}</h2>
    <p class="text-primary-foreground/70 -translate-y-1">{title}</p>
  </a>
  <p class="text-primary-foreground/80">{start}</p>
</div>
