---
import { buttonVariants } from "@/components/ui/button";
import { Icon } from "astro-icon/components";

import { cn } from "@/lib/utils";
import { currentLocale, localePath, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<div
  class="group bg-card border-border shadow-foreground/5 hover:bg-primary hover:text-primary-foreground flex flex-1 grid-rows-5 flex-col rounded-xl border p-6 shadow-lg transition-all duration-300 ease-out hover:-translate-y-1"
>
  <div class="row-span-4 flex flex-col gap-1">
    <h2 class="text-card-foreground group-hover:text-primary-foreground text-2xl font-semibold">
      {title}
    </h2>
    <p class="text-card-foreground/70 group-hover:text-primary-foreground">
      {description}
    </p>
  </div>
  <div class="flex justify-end">
    <a
      href={localePath(locale, href)}
      class={cn(
        "translate-x-3",
        buttonVariants({ variant: "link" }),
        "text-primary-foreground dark:text-card-foreground group-hover:text-primary-foreground dark:group-hover:text-primary-foreground text-lg"
      )}
    >
      {t(locale, "featured.viewProject")}
      <Icon size={24} name="material-symbols:arrow-right-alt" />
    </a>
  </div>
</div>
