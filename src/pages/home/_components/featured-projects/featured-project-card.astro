---
import { Button } from "@/components/ui/button";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<div
  class="group bg-card border-border shadow-foreground/5 hover:bg-primary hover:text-primary-foreground flex flex-1 grid-rows-5 flex-col rounded-xl border p-6 shadow-lg transition-all duration-300 ease-out hover:-translate-y-1"
>
  <div class="row-span-4 flex flex-col gap-1">
    <h2 class="text-card-foreground text-2xl font-semibold">{title}</h2>
    <p class="text-card-foreground/70">
      {description}
    </p>
  </div>
  <div class="flex justify-end">
    <a class="translate-x-3" href={href}>
      <Button variant="link" className="text-primary-foreground group-hover:text-primary-foreground cursor-pointer text-lg">
        View the project <Icon size={24} name="material-symbols:arrow-right-alt" />
      </Button>
    </a>
  </div>
</div>
