---
import { Icon } from "astro-icon/components";

import { currentLocale, localePath, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a
  href={localePath(locale, href)}
  class="group bg-card border-border shadow-foreground/5 hover:bg-primary hover:text-primary-foreground scroll-reveal flex flex-1 flex-col justify-between gap-6 rounded-xl border p-6 shadow-lg transition-[transform,background-color,border-color,box-shadow] duration-300 ease-out hover:-translate-y-1"
>
  <span class="flex flex-col gap-1">
    <h3 class="text-card-foreground group-hover:text-primary-foreground text-2xl font-semibold">
      {title}
    </h3>
    <p class="text-card-foreground/70 group-hover:text-primary-foreground">{description}</p>
  </span>
  <span class="text-foreground group-hover:text-primary-foreground flex items-center justify-end gap-1 text-lg font-medium">
    {t(locale, "featured.viewProject")}
    <Icon size={24} name="material-symbols:arrow-right-alt" />
  </span>
</a>
