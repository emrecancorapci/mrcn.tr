---
import { getCollection } from "astro:content";

import { buttonVariants } from "@/components/ui/button";
import H2 from "@/components/ui/h2.astro";
import Section from "@/components/ui/section.astro";
import { currentLocale, localePath, t } from "@/i18n";
import { baseId, forLocale } from "@/lib/i18n-content";
import FeaturedProjectCard from "./featured-project-card.astro";

const locale = currentLocale(Astro.currentLocale);

const featuredProjects = forLocale(await getCollection("project"), locale)
  .filter((project) => project.data.featured)
  .sort(
    (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title)
  );
---

<div class="flex w-full flex-col items-center py-20">
  <Section class="grid gap-10 lg:gap-20">
    <div class="grid w-full gap-20">
      <H2 class="text-shadow-foreground/5 scroll-reveal w-full text-shadow-lg">
        {t(locale, "featured.projectsHeading")}
      </H2>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        {featuredProjects.map((project) => (
          <FeaturedProjectCard
            title={project.data.title}
            description={project.data.description}
            href={`/projects/${baseId(project.id)}`}
          />
        ))}
      </div>
    </div>
    <div class="flex scroll-reveal justify-end">
      <a href={localePath(locale, "/projects")} class={buttonVariants({ size: "xl" })}>
        {t(locale, "featured.viewMore")}
      </a>
    </div>
  </Section>
</div>
