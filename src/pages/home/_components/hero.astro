---
import { buttonVariants } from "@/components/ui/button";
import H1 from "@/components/ui/h1.astro";
import { currentLocale, localePath, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);
---

<div
  class:list={[
    "bg-card flex w-full flex-col gap-8 px-20 py-40",
    "from-primary/10 to-primary/30 bg-linear-65 from-0% to-80%",
  ]}
>
  <div class="flex w-full flex-col items-center gap-2">
    <h2 class="bg-primary text-center text-primary-foreground w-fit px-2">{t(locale, "hero.badge")}</h2>
    <H1 class="text-shadow-foreground/5 max-w-5xl text-center text-balance text-shadow-lg">
      {t(locale, "hero.title")}
    </H1>
  </div>
  <div class="flex justify-center gap-2">
    <a href={localePath(locale, "/projects")} class={buttonVariants({ size: "xl" })}>
      {t(locale, "hero.seeWork")}
    </a>
    <a
      href="mailto:emrecancorapci@gmail.com"
      class={buttonVariants({ size: "xl", variant: "outline" })}
    >
      {t(locale, "hero.getInTouch")}
    </a>
  </div>
</div>
