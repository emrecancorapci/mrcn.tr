---
import Tag from "@/components/ui/tag.astro";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import { companyAnchor } from "@/lib/content";
import { currentLocale, t, type UIKeys } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  experience: CollectionEntry<"experiences">;
}

const contractKeys: Record<CollectionEntry<"experiences">["data"]["contractType"], UIKeys> = {
  "Full-Time": "experience.contract.Full-Time",
  "Part-Time": "experience.contract.Part-Time",
  "Freelance (Part-Time)": "experience.contract.Freelance (Part-Time)",
  "Freelance (Full-Time)": "experience.contract.Freelance (Full-Time)",
  "Contract (Part-Time)": "experience.contract.Contract (Part-Time)",
  "Contract (Full-Time)": "experience.contract.Contract (Full-Time)",
  Internship: "experience.contract.Internship",
};

const { Content } = await render(Astro.props.experience);
const experience = Astro.props.experience.data;
---

<experience-card
  id={companyAnchor(experience.company)}
  class="bg-card border-border data-at-center:border-primary data-at-center:shadow-primary/20 grid h-fit gap-4 rounded-xl border p-8 shadow-sm transition-[background-color,border-color,box-shadow] duration-300 ease-out data-at-center:shadow-md"
>
  <div class="grid gap-2">
    <div class="flex flex-col justify-center gap-2 md:flex-row md:justify-between">
      <div>
        <h2 class="text-foreground flex flex-col items-baseline gap-x-2 md:flex-row">
          <span class="w-full text-center text-2xl font-semibold md:w-fit md:text-start">
            {experience.title}
          </span>
          <span class="hidden text-3xl md:flex">-</span>
          <span class="text-muted-foreground w-full text-center text-lg font-normal md:w-fit md:text-start">
            {t(locale, contractKeys[experience.contractType])}
          </span>
        </h2>
        <h3 class="text-muted-foreground flex flex-col text-center text-lg font-normal md:flex-row md:text-start">
          <span class="text-primary-ink text-xl font-medium">{experience.company}</span>
          <span class="hidden md:flex">-</span>
          <span>{experience.location}</span>
        </h3>
      </div>
      <div class="flex justify-center pt-0 md:pt-1">
        <p class="text-muted-foreground border-border size-fit rounded-md border px-2 text-center">
          {experience.start} – {experience.end}
        </p>
      </div>
    </div>
  </div>
  <hr class="border-border" />

  <div class="prose-experience">
    <Content />
  </div>

  <ul class="flex flex-wrap gap-2">
    {experience.techs.map((t) => (
      <Tag Element="li" variant="secondary">
        {t}
      </Tag>
    ))}
  </ul>
</experience-card>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.target.toggleAttribute("data-at-center", entry.isIntersecting);
      }
    },
    { rootMargin: "-48% 0px -48% 0px" }
  );

  class ExperienceCard extends HTMLElement {
    connectedCallback() {
      observer.observe(this);
    }
    disconnectedCallback() {
      observer.unobserve(this);
    }
  }

  customElements.define("experience-card", ExperienceCard);
</script>
