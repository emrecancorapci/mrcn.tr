---
import Tag from "@/components/ui/tag.astro";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import { companyAnchor } from "@/lib/content";

interface Props {
  experience: CollectionEntry<"experiences">;
}

const { Content } = await render(Astro.props.experience);
const experience = Astro.props.experience.data;
---

<div
  id={companyAnchor(experience.company)}
  class="bg-primary grid h-fit gap-4 rounded-xl border p-8 shadow transition-all"
>
  <div class="grid gap-2">
    <div class="flex flex-col justify-center gap-2 md:flex-row md:justify-between">
      <div>
        <h2 class="text-primary-foreground text-center text-3xl font-bold md:text-start">
          {experience.title} - <span class="text-2xl">{experience.contractType}</span>
        </h2>
        <h3 class="text-primary-foreground text-center text-lg font-extralight md:text-start">
          <span class="text-xl font-normal">{experience.company}</span> - {experience.location}
        </h3>
      </div>
      <div class="flex justify-center pt-0 md:pt-1">
        <p
          class="text-primary-foreground border-primary-foreground size-fit rounded-lg border px-2 text-center"
        >
          {experience.start} - {experience.end}
        </p>
      </div>
    </div>
  </div>
  <hr class="border-primary-foreground" />

  <div class="prose-experience">
    <Content />
  </div>

  <ul class="flex flex-wrap gap-2">
    {
      experience.techs.map((t) => (
        <Tag
          class="bg-background text-foreground border text-center"
          Element="li"
          variant="secondary"
        >
          {t}
        </Tag>
      ))
    }
  </ul>
</div>
