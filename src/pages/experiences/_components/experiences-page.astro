---
import { getCollection } from "astro:content";

import ExperienceCard from "./experience-card.astro";
import LeftColumnLayout from "@/layouts/left-column-layout.astro";
import Layout from "@/layouts/layout.astro";
import { currentLocale, t } from "@/i18n";
import { forLocale } from "@/lib/i18n-content";

const locale = currentLocale(Astro.currentLocale);

const experiencesCollection = forLocale(await getCollection("experiences"), locale).sort(
  (a, b) => a.data.priority - b.data.priority
);
---

<Layout title={t(locale, "experiences.pageTitle")}>
  <LeftColumnLayout>
    <Fragment slot="title">{t(locale, "experiences.heading")}</Fragment>
    <Fragment slot="description">{t(locale, "experiences.description")}</Fragment>
    {experiencesCollection.map((e) => <ExperienceCard experience={e} />)}
  </LeftColumnLayout>
</Layout>
