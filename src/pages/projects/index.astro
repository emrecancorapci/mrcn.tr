---
import { getCollection } from "astro:content";

import ProjectCard from "./_components/project-card.astro";
import LeftColumnLayout from "@/layouts/left-column-layout.astro";
import Layout from "@/layouts/layout.astro";

const projectTypesMap = new Map(
  await getCollection("projectType").then((c) => c.map((t) => [t.id, t.data]))
);

const projectCollection = await getCollection("project").then((c) =>
  c.map((p) => {
    const { order: typeOrder, title: typeTitle } = projectTypesMap.get(p.data.projectType.id)!;

    return {
      ...p,
      typeId: p.data.projectType.id,
      typeOrder,
      typeTitle,
    };
  })
);

const typeCollections: { [key: string]: typeof projectCollection } = Object.groupBy(
  projectCollection,
  (p) => p.typeId
) as Record<string, typeof projectCollection>;
---

<Layout title="Projects - Emre Can Çorapçı">
  <LeftColumnLayout>
    <Fragment slot="title">Projects</Fragment>
    <Fragment slot="description">
      I like to work on projects that are challenging, but also fun. I'm always looking for ways to
      improve my skills and learn new things. Some are experiments, some are freelance work, one
      ended up on crates.io. I build things to understand them better, and to learn from them.
    </Fragment>
    <div class="grid w-full gap-8">
      {
        Object.values(typeCollections)
          .sort(([a], [b]) => (a?.typeOrder ?? 0) - (b?.typeOrder ?? 0))
          .map((collection) => (
            <div class="grid gap-4">
              <h2 class="text-foreground px-2 py-2 text-center text-3xl font-semibold">
                {collection[0]?.typeTitle}
              </h2>

              <div class={`grid gap-4 ${collection.length > 1 ? "md:grid-cols-2" : ""}`}>
                {collection.map(({ data: project, id }) => (
                  <ProjectCard
                    class="col-span-1 md:last:odd:col-span-2"
                    title={project.title}
                    href={`/projects/${id}`}
                    description={project.description}
                    tags={project.mainTags}
                  />
                ))}
              </div>
            </div>
          ))
      }
    </div>
  </LeftColumnLayout>
</Layout>
