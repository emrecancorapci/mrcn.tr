---
import Tag from "@/components/ui/tag.astro";
import { currentLocale, localePath } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  class?: string;
  title: string;
  href: string;
  description: string;
  tags: string[];
}

const { title, href, description, tags, class: className } = Astro.props;
---

<div
  class:list={[
    "group bg-primary relative overflow-hidden rounded-xl shadow-lg shadow-black/10",
    "hover:bg-card hover:shadow-secondary/20",
    "transition-all duration-300 ease-out",
    "flex flex-1 flex-col justify-between gap-4 pt-8 pb-0",
    "md:gap-0 md:pb-8",
    className,
  ]}
>
  <a href={localePath(locale, href)} class="after:absolute after:inset-0">
    <h3
      class="text-primary-foreground group-hover:text-card-foreground px-6 text-center text-2xl font-black transition-all"
    >
      {title}
    </h3>
  </a>
  <p
    class="text-primary-foreground group-hover:text-card-foreground row-span-2 flex items-center justify-center px-6 pb-0 text-center transition-all md:pb-2"
  >
    {description}
  </p>
  <div class="flex flex-wrap items-center justify-center gap-2 px-6 py-2 text-center md:py-0">
    {
      tags.map((tag) => (
        <Tag
          variant="secondary"
          class="group-hover:bg-primary group-hover:text-primary-foreground group-hover:shadow"
        >
          {tag}
        </Tag>
      ))
    }
  </div>
</div>
