---
import Tag from "@/components/ui/tag.astro";
import { currentLocale, localePath } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  class?: string;
  title: string;
  href: string;
  description: string;
  tags: string[];
}

const { title, href, description, tags, class: className } = Astro.props;
---

<div
  class:list={[
    "group bg-card border-border relative overflow-hidden rounded-xl border shadow-sm",
    "hover:border-primary/60 hover:shadow-lg",
    "transition-[background-color,border-color,box-shadow] duration-300 ease-out",
    "flex flex-1 flex-col justify-between gap-4 pt-8 pb-4",
    "md:gap-0 md:pb-8",
    className,
  ]}
>
  <a href={localePath(locale, href)} class="after:absolute after:inset-0">
    <h3 class="text-foreground group-hover:text-primary-ink px-6 text-center text-2xl font-semibold transition-colors">
      {title}
    </h3>
  </a>
  <p class="text-muted-foreground row-span-2 flex items-center justify-center px-6 pb-0 text-center md:pb-2">
    {description}
  </p>
  <div class="flex flex-wrap items-center justify-center gap-2 px-6 py-2 text-center md:py-0">
    {tags.map((tag) => (
      <Tag variant="secondary">{tag}</Tag>
    ))}
  </div>
</div>
