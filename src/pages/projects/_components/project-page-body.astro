---
import { render } from "astro:content";

import SingleProjectBlock from "./single-project-block.astro";
import SingleProjectFeatures from "./single-project-features.astro";
import SingleProjectHeader from "./single-project-header.astro";
import SingleProjectLinks from "./single-project-links.astro";
import SingleProjectSection from "./single-project-section.astro";
import SingleProjectSectionTitle from "./single-project-section-title.astro";
import type { CollectionEntry } from "astro:content";
import { currentLocale, t } from "@/i18n";

interface Props {
  project: CollectionEntry<"project">;
}

const locale = currentLocale(Astro.currentLocale);
const { project } = Astro.props;
const data = project.data;
const body = project.body;

const { Content } = await render(project);
const blocksOnTop = data.blocks?.filter((b) => b.onTop) ?? [];
---

<div class="grid gap-4 px-6 pt-4">
  <SingleProjectHeader project={data} />
  {data.links && <SingleProjectLinks links={data.links} />}
  {
    body && blocksOnTop.length > 0 && (
      <div class="flex w-full flex-col gap-4 md:hidden">
        {blocksOnTop.map((block) => (
          <SingleProjectBlock block={block} />
        ))}
      </div>
    )
  }
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-4">
    {
      body && (
        <SingleProjectSection class="col-span-1 shadow-lg md:col-span-3">
          <SingleProjectSectionTitle size="xl">
            {t(locale, "single.summary")}
          </SingleProjectSectionTitle>
          <div
            class:list={[
              "prose w-full px-0 py-4 md:px-4",
              "prose-h2:text-2xl prose-h2:font-bold prose-h2:text-secondary prose-h2:leading-relaxed prose-h2:mb-4 prose-h2:border-b prose-h2:border-primary",
              "prose-p:leading-relaxed prose-p:text-secondary-foreground",
              "prose-a:text-secondary-foreground",
              "prose-li:text-secondary ",
              "prose-strong:font-semibold prose-strong:text-secondary-foreground",
              "prose-pre:border-4 prose-pre:border-secondary/80 prose-pre:p-6!",
              "prose-img:p-0 prose-img:bg-secondary prose-img:rounded-md prose-img:border prose-img:border-secondary-foreground",
              "prose-table:mb-0",
              "prose-tr:border-secondary/80 prose-th:text-secondary prose-td:text-secondary",
              "prose-thead:border-secondary/80 prose-thead:border-b-2",
              "dark:prose-code:text-zinc-300 [&_p_code]:prose-code:text-primary-foreground",
            ]}
          >
            <Content />
          </div>
        </SingleProjectSection>
      )
    }
    {
      (data.blocks?.length ?? 0) > 0 && (
        <div
          class={`flex w-full gap-4 ${body ? "flex-col" : "col-span-4 flex-row justify-center"}`}
        >
          {data.blocks?.map((block) => (
            <SingleProjectBlock block={block} class={block.onTop && body ? "hidden md:grid" : ""} />
          ))}
        </div>
      )
    }
  </div>
  <SingleProjectFeatures title={data.title} />
</div>
