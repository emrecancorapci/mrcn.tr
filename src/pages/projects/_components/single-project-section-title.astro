---
interface Props {
  size?: "sm" | "md" | "lg" | "xl";
}

const { size = "md" } = Astro.props;

const SIZES = {
  sm: "text-xl py-2 md:px-2",
  md: "text-2xl py-3 md:px-3",
  lg: "text-3xl py-4 md:px-4",
  xl: "text-4xl py-4 md:px-4",
} as const;
---

<h3
  class:list={[
    "border-primary-foreground/50 dark:border-primary/70 border-b px-0 font-bold",
    SIZES[size],
  ]}
>
  <slot />
</h3>
