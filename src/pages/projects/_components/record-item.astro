---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div class="grid w-full grid-cols-5 gap-2 border-b pb-1">
  <p class="text-secondary col-span-2 text-sm font-semibold">
    {label}
    <span aria-hidden="true">:</span>
  </p>
  <p class="col-span-3 text-sm">{value}</p>
</div>
