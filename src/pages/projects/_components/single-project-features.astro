---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import H2 from "@/components/ui/h2.astro";
import SingleProjectSection from "./single-project-section.astro";
import SingleProjectSectionTitle from "./single-project-section-title.astro";
import { currentLocale, localePath, t } from "@/i18n";
import { baseId, forLocale } from "@/lib/i18n-content";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  /** Title of the current project, excluded from the featured strip. */
  title: string;
}

const OTHER_FEATURED_COUNT = 3;

const otherProjects = forLocale(await getCollection("project"), locale).filter(
  (p) => p.data.featured && p.data.title !== Astro.props.title
);
---

<div class="space-y-4 pt-4">
  <H2>{t(locale, "single.featuredHeading")}</H2>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {otherProjects.slice(0, OTHER_FEATURED_COUNT).map((p) => (
      <SingleProjectSection class="shadow-md">
        <SingleProjectSectionTitle size="sm">{p.data.title}</SingleProjectSectionTitle>
        <p class="h-full px-2 pe-12 pt-2">{p.data.description}</p>
        <a
          class="pt-2 font-semibold transition-colors duration-200 hover:underline"
          href={localePath(locale, `/projects/${baseId(p.id)}`)}
        >
          {t(locale, "single.viewProject")}
          <Icon
            size={20}
            name="material-symbols:arrow-right-alt"
            class="inline-block align-middle"
          />
        </a>
      </SingleProjectSection>
    ))}
  </div>
</div>
