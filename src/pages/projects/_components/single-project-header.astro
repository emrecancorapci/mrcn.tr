---
import type { CollectionEntry } from "astro:content";

import { currentLocale, t, type UIKeys } from "@/i18n";
import { getProjectTypesMap, projectTypeTitle } from "@/lib/content";

interface Props {
  project: CollectionEntry<"project">["data"];
}

const locale = currentLocale(Astro.currentLocale);
const projectTypesMap = await getProjectTypesMap(locale);

const statusKeys: Record<Props["project"]["status"], UIKeys> = {
  ongoing: "project.status.ongoing",
  completed: "project.status.completed",
  "prototype-completed": "project.status.prototype-completed",
  archived: "project.status.archived",
};

const { project } = Astro.props;
---

<div class="border-border bg-card text-foreground shadow-foreground/5 flex flex-col items-center justify-center gap-16 rounded-xl border px-4 pt-16 pb-10 text-center shadow-sm md:pt-20">
  <div class="flex flex-col items-center">
    <div class="flex w-full flex-col">
      <div class="flex w-full justify-center">
        {project.version && (
          <div class="flex w-full justify-end">
            <p class="bg-primary text-primary-foreground h-min rounded-full px-3 py-0.5 text-sm font-semibold">
              {project.version}
            </p>
          </div>
        )}
      </div>
      <h1 class="w-full text-4xl font-bold text-balance md:text-6xl">{project.title}</h1>
    </div>
    <p class="text-muted-foreground w-full max-w-4xl pt-5 font-medium">{project.description}</p>
  </div>
  <div class="grid w-full grid-cols-3 gap-4">
    <div class="flex flex-col gap-0.5">
      <p class="text-muted-foreground leading-none font-medium">{t(locale, "single.labelYear")}</p>
      <p class="text-lg leading-tight font-semibold">{project.year}</p>
    </div>
    <div class="flex flex-col gap-0.5">
      <p class="text-muted-foreground leading-none font-medium">{t(locale, "single.labelType")}</p>
      <p class="text-lg leading-tight font-semibold">
        {projectTypeTitle(projectTypesMap, project.projectType.id)}
      </p>
    </div>
    <div class="flex flex-col gap-0.5">
      <p class="text-muted-foreground leading-none font-medium">
        {t(locale, "single.labelStatus")}
      </p>
      <p class="text-lg leading-tight font-semibold">{t(locale, statusKeys[project.status])}</p>
    </div>
  </div>
</div>
