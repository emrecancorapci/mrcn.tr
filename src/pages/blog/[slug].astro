---
import { getCollection } from "astro:content";

import Layout from "@/layouts/layout.astro";
import { currentLocale, t } from "@/i18n";
import { entryLocale } from "@/lib/i18n-content";
import PostPageBody from "./_components/post-page-body.astro";

const locale = currentLocale(Astro.currentLocale);

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => entryLocale(post.id) === "en");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout title={t(locale, "blog.postPageTitle", { title: post.data.title })}>
  <PostPageBody post={post} />
</Layout>
