---
import { getCollection } from "astro:content";

import PostCard from "./post-card.astro";
import LeftColumnLayout from "@/layouts/left-column-layout.astro";
import Layout from "@/layouts/layout.astro";
import { currentLocale, t } from "@/i18n";
import { forLocale } from "@/lib/i18n-content";

const locale = currentLocale(Astro.currentLocale);

const posts = forLocale(await getCollection("blog"), locale).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={t(locale, "blog.pageTitle")}>
  <LeftColumnLayout>
    <Fragment slot="title">{t(locale, "blog.heading")}</Fragment>
    <Fragment slot="description">{t(locale, "blog.description")}</Fragment>
    <div class="grid gap-8 ps-0 md:ps-8">
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} />)
      ) : (
        <p>No post published yet.</p>
      )}
    </div>
  </LeftColumnLayout>
</Layout>
