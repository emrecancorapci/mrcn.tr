---
import { getCollection } from "astro:content";

import SkillCard from "./skill-card.astro";
import LeftColumnLayout from "@/layouts/left-column-layout.astro";
import Layout from "@/layouts/layout.astro";
import { currentLocale, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

const skills = await getCollection("skills");
---

<Layout title={t(locale, "skills.pageTitle")}>
  <LeftColumnLayout>
    <Fragment slot="title">{t(locale, "skills.heading")}</Fragment>
    <Fragment slot="description">{t(locale, "skills.description")}</Fragment>
    {
      skills.map(({ data: { title, items } }, index) => (
        <div class="grid grid-cols-1 gap-4 py-4">
          <h2 class="text-3xl font-bold">{title}</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {items
              .toSorted((a, b) => b.proficiency - a.proficiency)
              .map((s) => (
                <SkillCard skill={s} />
              ))}
          </div>
          {index < skills.length - 1 && <hr class="border-primary/10 border-b" />}
        </div>
      ))
    }
  </LeftColumnLayout>
</Layout>
