---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

interface Props {
  skill: CollectionEntry<"skills">["data"]["items"][0];
}

const getProficiency = (c: number) => {
  switch (c) {
    case 1:
      return "Familiar";
    case 2:
      return "Comfortable";
    case 3:
      return "Proficient";
    case 4:
      return "Advanced";
    case 5:
      return "Expert";
    default:
      return "Unknown";
  }
};

const {
  skill: { icon, color, title, proficiency },
} = Astro.props;
---

<div class="bg-primary/80 flex gap-4 rounded-xl p-2">
  <div class="bg-background/80 aspect-square size-16 rounded-lg p-3">
    {icon && <Icon class:list={["size-full", color]} name={icon} />}
  </div>
  <div class="flex w-full items-center justify-between">
    <p class="text-xl font-light sm:text-lg md:text-xl">{title}</p>
    <p class="text-secondary-foreground pe-2 text-lg font-bold sm:text-base md:text-lg">
      {getProficiency(proficiency)}
    </p>
  </div>
</div>
