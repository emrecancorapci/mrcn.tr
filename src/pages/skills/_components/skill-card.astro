---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

import { currentLocale, t, type UIKeys } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

interface Props {
  skill: CollectionEntry<"skills">["data"]["items"][0];
}

/** Proficiency scale (1-5) mapped to translation keys. */
const PROFICIENCY_KEYS: Record<number, UIKeys> = {
  1: "skill.proficiency.1",
  2: "skill.proficiency.2",
  3: "skill.proficiency.3",
  4: "skill.proficiency.4",
  5: "skill.proficiency.5",
};

const {
  skill: { icon, color, title, proficiency },
} = Astro.props;
---

<div class="bg-primary/80 flex gap-4 rounded-xl p-2">
  <div class="dark:bg-background/80 bg-foreground/80 aspect-square size-16 rounded-lg p-3">
    {icon && <Icon class:list={["size-full", color]} name={icon} />}
  </div>
  <div class="flex w-full items-center justify-between">
    <p class="text-primary-foreground text-xl font-light sm:text-lg md:text-xl">{title}</p>
    <p class="text-primary-foreground/80 pe-2 text-lg font-bold sm:text-base md:text-lg">
      {PROFICIENCY_KEYS[proficiency] ? t(locale, PROFICIENCY_KEYS[proficiency]) : "Unknown"}
    </p>
  </div>
</div>
