---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

interface Props {
  skill: CollectionEntry<"skills">["data"]["items"][0];
}

/** Proficiency scale (1-5) mapped to display labels. */
const PROFICIENCY_LABELS: Record<number, string> = {
  1: "Familiar",
  2: "Comfortable",
  3: "Proficient",
  4: "Advanced",
  5: "Expert",
};

const {
  skill: { icon, color, title, proficiency },
} = Astro.props;
---

<div class="bg-primary/80 flex gap-4 rounded-xl p-2">
  <div class="dark:bg-background/80 bg-foreground/80 aspect-square size-16 rounded-lg p-3">
    {icon && <Icon class:list={["size-full", color]} name={icon} />}
  </div>
  <div class="flex w-full items-center justify-between">
    <p class="text-primary-foreground text-xl font-light sm:text-lg md:text-xl">{title}</p>
    <p class="text-primary-foreground/80 pe-2 text-lg font-bold sm:text-base md:text-lg">
      {PROFICIENCY_LABELS[proficiency] ?? "Unknown"}
    </p>
  </div>
</div>
