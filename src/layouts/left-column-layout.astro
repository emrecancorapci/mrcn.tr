---
import H1 from "@/components/ui/h1.astro";
---

<div class="grid size-full grid-cols-1 gap-4 px-6 lg:grid-cols-4">
  <div class="col-span-1 flex flex-col gap-4 py-8 lg:col-span-1">
    <H1 class="w-full border-b border-foreground/20 pb-4 lg:text-5xl">
      <slot name="title" />
    </H1>
    <p class="text-muted-foreground pe-12 text-lg">
      <slot name="description" />
    </p>
  </div>
  <div class="col-span-1 grid gap-8 py-8 lg:col-span-3">
    <slot />
  </div>
</div>
