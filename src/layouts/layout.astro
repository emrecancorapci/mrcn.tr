---
import Header from "@/components/layout/header.astro";
import PromoBar from "@/components/layout/promo-bar.astro";
import BaseLayout from "./base.astro";
import Footer from "@/components/layout/footer.astro";
import type { BaseProps } from "./base-types";

interface Props extends BaseProps {
  full?: boolean;
}

const { full, ...props } = Astro.props as Props;
---

<BaseLayout {...props}>
  <div class="mx-auto flex min-h-screen w-full flex-col items-center">
    <PromoBar />
    <Header />

    <main class:list={["w-full", !full && "max-w-7xl"]}>
      <slot />
    </main>

    <Footer />
  </div>
</BaseLayout>
