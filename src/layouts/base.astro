---
import "@/styles/global.css";

import PostHog from "@/components/post-hog.astro";
import { Font } from "astro:assets";
import type { BaseProps } from "./base-types";

interface Props extends BaseProps {}

const isProd = import.meta.env.PROD;

const { title, description } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Applies the persisted or system theme before first paint to avoid a flash.
      const theme =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font preload cssVariable="--font-outfit" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? "Emre Can Çorapçı"}</title>
    <meta name="description" content={description ?? "Emre Can Çorapçı's personal website"} />
    {isProd && <PostHog />}
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans">
    <slot />
  </body>
</html>
