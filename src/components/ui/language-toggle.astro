---
import { currentLocale, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);
const { pathname } = Astro.url;

// Counterpart URL of the current page in the other locale.
const counterpartPath =
  locale === "tr"
    ? pathname.replace(/^\/tr(?=\/|$)/, "") || "/"
    : pathname === "/"
      ? "/tr/"
      : `/tr${pathname}`;
---

<a
  href={counterpartPath}
  aria-label={t(locale, "a11y.toggleLanguage")}
  class="text-muted-foreground hover:text-foreground hover:border-primary flex h-9 cursor-pointer items-center rounded-4xl border border-transparent px-3 text-sm font-semibold transition-colors"
>
  {locale === "tr" ? "EN" : "TR"}
</a>
