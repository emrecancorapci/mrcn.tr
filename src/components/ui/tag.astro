---
import { cn } from "@/lib/utils";

interface Props {
  Element?: "p" | "li";
  variant?: "primary" | "secondary" | "tertiary";
  class?: string;
}

const { Element = "p", variant = "primary", class: className } = Astro.props;

const VARIANTS = {
  primary: "bg-primary text-primary-foreground",
  secondary: "bg-secondary text-secondary-foreground",
  tertiary: "bg-background text-foreground border border-border",
} as const;

const classString = cn([
  "rounded-md py-1 text-sm px-2 transition-colors duration-200",
  VARIANTS[variant],
  className,
]);
---

{
  <Element class={classString}>
    <slot />
  </Element>
}
