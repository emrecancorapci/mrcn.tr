---
import { cn } from "@/lib/utils";

interface Props {
  Element?: "p" | "li";
  variant?: "primary" | "secondary" | "tertiary";
  class?: string;
}

const { Element = "p", variant = "primary", class: className } = Astro.props;

const VARIANTS = {
  primary: "bg-primary text-primary-foreground rounded",
  secondary: "bg-secondary text-secondary-foreground rounded-lg font-light",
  tertiary: "bg-background text-foreground rounded-lg font-light",
} as const;

const classString = cn([
  "py-1 text-sm px-2 transition-all duration-300 ease-out",
  VARIANTS[variant],
  className,
]);
---

{
  (
    <Element class={classString}>
      <slot />
    </Element>
  )
}
