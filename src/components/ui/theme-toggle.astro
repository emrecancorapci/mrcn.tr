---
import { Icon } from "astro-icon/components";
import { currentLocale, t } from "@/i18n";
const locale = currentLocale(Astro.currentLocale);
---

<theme-toggle>
  <button type="button" class="text-muted-foreground hover:text-foreground flex cursor-pointer items-center p-2 transition-colors" aria-label={t(locale, "a11y.toggleTheme")}>
    <Icon name="material-symbols:dark-mode-rounded" class="inline size-6 dark:hidden" />
    <Icon name="material-symbols:light-mode-rounded" class="hidden size-6 dark:inline" />
  </button>
</theme-toggle>

<script>
  class ThemeToggleElement extends HTMLElement {
    #onClick = () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    };
    connectedCallback() { this.addEventListener("click", this.#onClick); }
    disconnectedCallback() { this.removeEventListener("click", this.#onClick); }
  }
  customElements.define("theme-toggle", ThemeToggleElement);
</script>