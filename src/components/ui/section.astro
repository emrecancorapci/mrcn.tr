---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Shared page section container: owns max-width and horizontal padding. -->
<section class={cn("mx-auto w-full max-w-7xl px-6 md:px-10", className)}>
  <slot />
</section>
