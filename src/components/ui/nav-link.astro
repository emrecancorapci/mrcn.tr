---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  roundingBase?: boolean;
}

const { href, roundingBase, ...props } = Astro.props;
const { pathname } = Astro.url;

const isActive = pathname.startsWith(href);
---

{
  roundingBase ?
    <a
      class:list={[
        "flex items-center px-4 py-2 font-semibold transition-all duration-200 ease-out",
        "hover:border-primary border-b-2 first:rounded-bl-3xl last:rounded-br-3xl",
        isActive ? "border-primary shadow-primary/10 shadow-lg" : "border-primary-foreground",
      ]}
      href={href}
      {...props}
    >
      <slot />
    </a>
  : <a
      class:list={[
        "flex items-center px-4 py-2 font-semibold transition-all duration-200 ease-out",
        "border-primary/50 shadow-secondary/15 border not-first:border-l-0 first:rounded-l-3xl last:rounded-r-3xl hover:shadow-lg",
        isActive ?
          "bg-primary text-primary-foreground"
        : "text-foreground bg-background hover:text-foreground dark:hover:text-background hover:bg-chart-1",
      ]}
      href={href}
      {...props}
    >
      <slot />
    </a>
}
