---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  roundingBase?: boolean;
}

const { href, roundingBase, ...props } = Astro.props;
const { pathname } = Astro.url;

const isActive = pathname.startsWith(href);
---

<a
  class:list={[
    "flex items-center px-4 py-2 font-semibold transition-all duration-200 ease-out",
    roundingBase ?
      "border-primary-foreground hover:border-primary border-b-2 pt-4 first:rounded-bl-3xl last:rounded-br-3xl"
    : "border border-secondary/50 hover:bg-secondary hover:text-secondary-foreground first:rounded-l-3xl last:rounded-r-3xl",
    isActive ? "border-secondary" : "",
  ]}
  href={href}
  {...props}
>
  <slot />
</a>
