---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { href, ...props } = Astro.props;
const { pathname } = Astro.url;

const isActive = pathname.startsWith(href);
---

<a
  class:list={[
    "flex w-full justify-center items-center px-3 py-2 font-semibold transition-colors duration-200 ease-out sm:px-4",
    "border-border border not-first:border-l-0 first:rounded-l-full last:rounded-r-full",
    isActive
      ? "bg-primary text-primary-foreground"
      : "text-foreground bg-background hover:bg-secondary",
  ]}
  href={href}
  {...props}
>
  <slot />
</a>
