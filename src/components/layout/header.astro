---
import LanguageToggle from "@/components/ui/language-toggle.astro";
import NavLink from "@/components/ui/nav-link.astro";
import ThemeToggle from "@/components/ui/theme-toggle.astro";
import { currentLocale, localePath, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

const links = [
  {
    href: "/projects",
    title: t(locale, "nav.projects"),
    prefetch: true,
  },
  {
    href: "/experiences",
    title: t(locale, "nav.experiences"),
  },
  {
    href: "/skills",
    title: t(locale, "nav.skills"),
  },
];
---

<header class="flex w-full max-w-7xl flex-col items-center justify-between gap-4 p-6 sm:flex-row">
  <a
    class="text-shadow-primary/10 hover:text-primary text-center text-4xl leading-none font-black transition-all duration-300 hover:text-shadow-md lg:text-left lg:text-3xl"
    href={localePath(locale, "/")}
  >
    emre can
  </a>

  <div class="flex items-center gap-2">
    <nav class="flex justify-center">
      {
        links.map((link) => (
          <NavLink
            href={localePath(locale, link.href)}
            {...(link.prefetch && { "data-astro-prefetch": "true" })}
          >
            {link.title}
          </NavLink>
        ))
      }
    </nav>
    <ThemeToggle />
    <LanguageToggle />
  </div>
</header>
