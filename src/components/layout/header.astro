---
import LanguageToggle from "@/components/ui/language-toggle.astro";
import NavLink from "@/components/ui/nav-link.astro";
import ThemeToggle from "@/components/ui/theme-toggle.astro";
import { currentLocale, localePath, t } from "@/i18n";

const locale = currentLocale(Astro.currentLocale);

const links = [
  {
    href: "/projects",
    title: t(locale, "nav.projects"),
    prefetch: true,
  },
  {
    href: "/experiences",
    title: t(locale, "nav.experiences"),
  },
  {
    href: "/skills",
    title: t(locale, "nav.skills"),
  },
  {
    href: "/blog",
    title: t(locale, "nav.blog"),
  },
];
---

<header class="flex w-full max-w-7xl flex-col items-center justify-between gap-4 p-6 md:flex-row">
  <div class="flex justify-between w-full ps-4 md:ps-0">
    <a
      class="hover:text-primary-ink text-center text-4xl leading-none font-black transition-colors duration-300 md:text-left"
      href={localePath(locale, "/")}
    >
      emre can
    </a>
    <div class="flex items-center md:hidden">
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </div>

  <div class="flex items-center justify-center gap-2">
    <nav class="flex w-full justify-center md:w-fit">
      {links.map((link) => (
        <NavLink
          href={localePath(locale, link.href)}
          {...(link.prefetch && { "data-astro-prefetch": "true" })}
        >
          {link.title}
        </NavLink>
      ))}
    </nav>
    <div class="hidden items-center md:flex">
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </div>
</header>
