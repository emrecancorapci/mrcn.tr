---
import NavLink from "@/components/ui/nav-link.astro";
import ThemeToggle from "@/components/ui/theme-toggle.astro";

const links = [
  {
    href: "/projects",
    title: "projects",
    prefetch: true,
  },
  {
    href: "/experiences",
    title: "experiences",
  },
  {
    href: "/skills",
    title: "skills",
  },
];
---

<header class="flex w-full max-w-7xl flex-col items-center justify-between gap-4 p-6 sm:flex-row">
  <a
    class="text-shadow-primary/10 leading-none font-black transition-all duration-300 hover:text-shadow-md hover:text-primary text-center text-4xl lg:text-left lg:text-3xl"
    href="/"
  >
    emre can
  </a>

  <div class="flex items-center gap-2">
    <nav class="flex justify-center">
      {
        links.map((link) => (
          <NavLink href={link.href} {...(link.prefetch && { "data-astro-prefetch": "true" })}>
            {link.title}
          </NavLink>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
