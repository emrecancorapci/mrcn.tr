---
import { Icon } from "astro-icon/components";
import ExternNavLink from "../ui/extern-nav-link.astro";

const footerLinks = [
  {
    title: "Portfolio",
    links: [
      { title: "Home", href: "/" },
      { title: "Projects", href: "/projects" },
      { title: "Experiences", href: "/experiences" },
      { title: "Skills", href: "/skills" },
    ],
  },
  {
    title: "Featured Projects",
    links: [
      { title: "krustie", href: "/projects/krustie" },
      { title: "mrcn.tr", href: "/projects/mrcntr" },
      { title: "Redis Clone", href: "/projects/redis-clone" },
    ],
  },
];

const socialLinks = [
  { title: "LinkedIn", href: "https://www.linkedin.com/in/emrecancorapci" },
  { title: "Github", href: "https://github.com/emrecancorapci" },
  { title: "crates.io", href: "https://crates.io/users/emrecancorapci" },
  { title: "Substack", href: "https://substack.com/@mrcnc" },
];
---

<footer class="flex w-full flex-col items-center px-4 py-8">
  <div class="flex w-full max-w-7xl flex-col justify-between p-0 md:flex-row">
    <div class="flex w-full flex-col gap-4">
      <div>
        <div
          class="flex w-full flex-col items-center justify-start gap-2 lg:flex-row lg:items-end lg:gap-8"
        >
          <h2 class="text-foreground text-4xl leading-tight font-bold lg:text-5xl">
            Emre Can Çorapçı
          </h2>
          <div class="text-primary flex items-center justify-center gap-2 pb-2 lg:pb-3">
            <ExternNavLink
              class="hover:text-secondary-foreground"
              href="https://www.linkedin.com/in/emrecancorapci"
              aria-label="Emre Can Çorapçı's LinkedIn Profile"
            >
              <Icon name="simple-icons:linkedin" class="text-2xl" />
            </ExternNavLink>
            <ExternNavLink
              class="hover:text-secondary-foreground"
              href="https://github.com/emrecancorapci"
              aria-label="Emre Can Çorapçı's GitHub Profile"
            >
              <Icon name="simple-icons:github" class="text-2xl" />
            </ExternNavLink>
            <ExternNavLink
              class="hover:text-secondary-foreground"
              href="mailto:emrecancorapci@gmail.com"
              aria-label="Emre Can Çorapçı's Email"
            >
              <Icon
                name="material-symbols:mail-rounded"
                class="-m-0.5 -mt-0.75 text-center text-3xl"
              />
            </ExternNavLink>
            <ExternNavLink
              class="hover:text-secondary-foreground"
              href="https://static.mrcn.tr/emre_can_corapci_cv.pdf"
              aria-label="Emre Can Çorapçı's CV"
            >
              <p class="-mt-1 text-2xl font-black">CV</p>
            </ExternNavLink>
          </div>
        </div>
        <p class="text-foreground/70 text-center lg:text-start">
          full-stack software developer | open source contributor | i use arch btw
        </p>
      </div>
      <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 md:gap-4">
        {
          footerLinks.map(({ title, links }) => (
            <div>
              <h3 class="text-primary pb-2 font-medium tracking-wider uppercase">{title}</h3>
              <ul class="grid gap-2">
                {links.map(({ title, href }) => (
                  <li>
                    <a
                      href={href}
                      class="text-secondary-foreground hover:border-primary hover:text-primary border-b border-transparent transition-all duration-300 ease-in-out"
                    >
                      {title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div class="pt-4 md:pt-0">
      <div
        class="border-secondary flex h-full w-full flex-col items-start lg:border-0 border-t lg:pt-0 pt-4 lg:items-end justify-center gap-2 md:w-fit md:flex-col md:justify-end md:pe-2 md:pt-0"
      >
        {
          socialLinks.map(({ title, href }) => (
            <a
              href={href}
              class="group text-foreground hover:text-foreground/80 flex items-center gap-0 transition-colors md:gap-0.5"
            >
              <span class="text-lg font-medium md:text-xl">{title}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-up-right h-6 w-6 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="mt-16 w-full">
    <div
      data-orientation="horizontal"
      role="none"
      data-slot="separator"
      class="bg-border mb-8 shrink-0 data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch"
    >
    </div>
  </div>
  <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
    <p class="text-muted-foreground text-sm">© Copyright 2026. All rights Reserved.</p>
  </div>
</footer>
